// vNES.mmp — Symbian project file (S60 3rd Edition / 5th Edition)
// Компилировать: bldmake bldfiles && abld build gcce urel
//                 (или через Carbide.c++ IDE)

TARGET          vnes.exe
TARGETTYPE      exe

UID             0x100039CE 0xE0000001

EPOCHEAPSIZE    0x100000 0x1000000   // 1 MB min, 16 MB max heap
EPOCSTACKSIZE   0x10000              // 64 KB stack

SOURCEPATH      ../src
SOURCE          Globals.cpp
SOURCE          NESMemory.cpp
SOURCE          NESROM.cpp
SOURCE          NESMapper.cpp
SOURCE          NESCPU.cpp
SOURCE          NESPPU.cpp
SOURCE          NESPAPU.cpp
SOURCE          NESSystem.cpp
SOURCE          vNESAppView.cpp
SOURCE          vNESAppUi.cpp

USERINCLUDE     ../inc
SYSTEMINCLUDE   \epoc32\include
SYSTEMINCLUDE   \epoc32\include\mw
SYSTEMINCLUDE   \epoc32\include\platform\mw

LIBRARY         euser.lib
LIBRARY         eikcore.lib
LIBRARY         avkon.lib
LIBRARY         cone.lib
LIBRARY         ws32.lib
LIBRARY         fbscli.lib
LIBRARY         bitgdi.lib
LIBRARY         gdi.lib
LIBRARY         efsrv.lib
LIBRARY         estor.lib
LIBRARY         mediaclientaudiostream.lib   // CMdaAudioOutputStream
LIBRARY         aknfileselectiondialog.lib   // CAknFileSelectionDialog
LIBRARY         eikdlg.lib
LIBRARY         apparc.lib
LIBRARY         apgrfx.lib

CAPABILITY      ReadUserData WriteUserData UserEnvironment

// Иконка (необязательна)
// AIF  vnes.aif ../aif vnesaif.rss

// Версия
VERSION         1.0
